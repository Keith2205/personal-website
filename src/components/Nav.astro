---
// The nav bleeds to the edges of its container with negative margins, so the
// parent must have 40px of padding (20px under 800px) for it to line up.
---

<nav class="nav">
  <a href="/projects">Projects</a>
  <a href="/writing">Writings</a>
  <a href="/about">About</a>
  <a class="logo" href="/">
    <img src="/images/logo.webp" alt="" />
    <span class="home-note">
      <span>Home</span>
      <img class="home-arrow" src="/images/home-arrow.webp" alt="" />
    </span>
  </a>
</nav>

<style>
  .nav {
    display: flex;
    align-items: center;
    gap: 100px;
    margin: -40px -40px 0;
    padding: 40px 40px 20px;
    border-bottom: 3px solid #0e0a01;
    font-family: 'Caveat', cursive;
    font-size: 28px;
  }

  .nav a {
    color: #2f3a5c;
    text-decoration: none;
  }

  .logo {
    margin-left: auto;
    position: relative;
  }

  .logo > img {
    width: 46px;
    height: 46px;
    display: block;
  }

  .home-note {
    position: absolute;
    right: 100%;
    top: 20%;
    display: flex;
    align-items: flex-end;
    gap: 0px;
    font-size: 30px;
    white-space: nowrap;
  }

  .home-arrow {
    width: 50px;
  }

  /* --- mobile --- */

  @media (max-width: 800px) {
    .nav {
      gap: 20px;
      margin: -20px -20px 0;
      padding: 10px 10px 10px;
      font-size: 22px;
    }
    .home-note {
        position: absolute;
        right: 100%;
        top: 20%;
        display: flex;
        align-items: flex-end;
        gap: 0px;
        font-size: 22px;
        white-space: nowrap;
    }
  }
</style>
