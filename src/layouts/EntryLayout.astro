---
import SiteLayout from './SiteLayout.astro';
import PageLayout from './PageLayout.astro';

interface Props {
	title: string;
	date: Date;
	/** Projects keep the sidebar (SiteLayout); writing goes full-width (PageLayout). */
	layout: 'site' | 'page';
}

const { title, date, layout } = Astro.props;
const Layout = layout === 'site' ? SiteLayout : PageLayout;

// Frontmatter dates parse as UTC midnight, so format in UTC too; local
// formatting would render the previous day west of Greenwich.
const iso = date.toISOString().slice(0, 10);
const pretty = date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<Layout title={title}>
	<article class={`entry entry-${layout}`}>
		<h1>{title}</h1>
		<p class="entry-date">
			{layout === 'site' && <strong>Last updated: </strong>}<time datetime={iso}>{pretty}</time>
		</p>
		<slot />
	</article>
</Layout>

<style>
  .entry-site {
    max-width: 150ch;
    line-height: 1.5;
  }

  .entry-site h1 {
    font-family: 'Caveat', cursive;
    font-size: 44px;
    font-weight: 600;
    margin: 20px 0 0;
  }
</style>