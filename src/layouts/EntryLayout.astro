---
import SiteLayout from './SiteLayout.astro';
import Book from '../components/Book.astro';

interface Props {
	title: string;
	date: Date;
	/** Projects get the wider entry styles and a "Last updated" label. */
	kind: 'project' | 'writing';
}

const { title, date, kind } = Astro.props;

// Frontmatter dates parse as UTC midnight, so format in UTC too; local
// formatting would render the previous day west of Greenwich.
const iso = date.toISOString().slice(0, 10);
const pretty = date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<SiteLayout title={title}>
	<article class={`entry entry-${kind}`}>
		{kind === 'writing' ? (
			<Book>
				<Fragment slot="left">
					<h1 class="leaf-title">{title}</h1>
					<p class="entry-date"><time datetime={iso}>{pretty}</time></p>
					<a class="back-link" href="/writing">← Back to contents</a>
				</Fragment>
				<Fragment slot="right">
					<slot />
				</Fragment>
			</Book>
		) : (
			<>
				<h1>{title}</h1>
				<p class="entry-date">
					<strong>Last updated: </strong><time datetime={iso}>{pretty}</time>
				</p>
				<slot />
			</>
		)}
	</article>
</SiteLayout>

<style>
  .entry-project {
    max-width: 150ch;
    line-height: 1.5;
  }

  .entry-project h1 {
    font-family: 'Caveat', cursive;
    font-size: 44px;
    font-weight: 600;
    margin: 20px 0 0;
  }

  .entry-writing {
    line-height: 1.6;
  }

  .entry-writing .entry-date {
    color: #7a705c;
    margin: 0 0 16px;
  }

  .back-link {
    color: #0b44c4;
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }
</style>