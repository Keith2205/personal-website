---
import SiteLayout from './SiteLayout.astro';
import Book from '../components/Book.astro';

interface Props {
	title: string;
	date: Date;
	/** Projects get the wider entry styles and a "Last updated" label. */
	kind: 'project' | 'writing';
	/** For writing only: stories let paragraphs split across pages, poems keep stanzas whole. */
	form?: 'poem' | 'story';
	/** Stories only: whole minutes to read, worked out at build time. */
	readMinutes?: number;
}

const { title, date, kind, form, readMinutes } = Astro.props;
const readLabel = readMinutes
	? `Read time: ${readMinutes} min${readMinutes >= 10 ? ' · take your time' : ''}`
	: '';

// Frontmatter dates parse as UTC midnight, so format in UTC too; local
// formatting would render the previous day west of Greenwich.
const iso = date.toISOString().slice(0, 10);
const pretty = date.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<SiteLayout title={title}>
	<article class:list={['entry', `entry-${kind}`, kind === 'writing' && form && `entry-${form}`]}>
		{kind === 'writing' ? (
			<>
			{form === 'story' && (
				<>
					<div class="read-bar" hidden aria-hidden="true">
						<div class="read-bar-fill"></div>
						<span class="read-bar-text">{readLabel}</span>
					</div>
					<a class="to-top" href="#top" aria-label="Back to top"><span aria-hidden="true">↑</span></a>
				</>
			)}
			<Book>
				<Fragment slot="left">
					<h1 class="leaf-title">{title}</h1>
					<p class="entry-date">
						<time datetime={iso}>{pretty}</time>
						{form === 'story' && readMinutes && <><br />About {readMinutes} min read</>}
					</p>
					<a class="back-link" href="/writing">← Back to contents</a>
				</Fragment>
				<Fragment slot="right">
					<div class="pager">
						<div class="pages">
							<slot />
						</div>
					</div>
					<div class="pager-controls" hidden>
						<button type="button" class="pager-prev"><span aria-hidden="true">←</span> Prev</button>
						<span aria-hidden="true">·</span>
						<span class="pager-status" aria-live="polite"></span>
						<span aria-hidden="true">·</span>
						<button type="button" class="pager-next">Next <span aria-hidden="true">→</span></button>
					</div>
				</Fragment>
			</Book>
			<script is:inline>
				// Desktop pagination for the right leaf. The content is laid out in
				// CSS columns, one per page, and shifted sideways to show one at a
				// time. Without this script the class is never added and the entry
				// reads as one scrolling block.
				(() => {
					const entry = document.currentScript.closest('.entry-writing');
					const pager = entry.querySelector('.pager');
					const pages = entry.querySelector('.pages');
					const controls = entry.querySelector('.pager-controls');
					const prev = controls.querySelector('.pager-prev');
					const next = controls.querySelector('.pager-next');
					const status = controls.querySelector('.pager-status');
					const desktop = matchMedia('(min-width: 801px)');
					let page = 0;
					let count = 1;

					const stride = () => pages.clientWidth + (parseFloat(getComputedStyle(pages).columnGap) || 0);

					// Count pages from where the content actually ends: the right edge
					// of the last line box, relative to the first column.
					function measure() {
						const last = pages.lastElementChild;
						if (!last) return 1;
						const rects = last.getClientRects();
						if (!rects.length) return 1;
						const end = rects[rects.length - 1].right - pages.getBoundingClientRect().left;
						return Math.max(1, Math.ceil((end - 1) / stride()));
					}

					function show() {
						pages.style.transform = page ? `translateX(${-page * stride()}px)` : '';
						status.textContent = `Page ${page + 1} of ${count}`;
						prev.setAttribute('aria-disabled', String(page === 0));
						next.setAttribute('aria-disabled', String(page === count - 1));
					}

					function go(n) {
						if (n < 0 || n >= count || n === page) return;
						page = n;
						show();
					}

					function layout() {
						entry.classList.toggle('paginated', desktop.matches);
						if (!desktop.matches) {
							page = 0;
							count = 1;
							pages.style.transform = '';
							controls.hidden = true;
							return;
						}
						// Measure with the controls showing, since they take height
						// from the page; if everything still fits, hiding them only
						// adds room.
						controls.hidden = false;
						count = measure();
						controls.hidden = count < 2;
						page = Math.min(page, count - 1);
						show();
					}

					prev.addEventListener('click', () => go(page - 1));
					next.addEventListener('click', () => go(page + 1));

					document.addEventListener('keydown', (e) => {
						if (controls.hidden || e.defaultPrevented || e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
						if (e.target.closest?.('input, textarea, select, [contenteditable]')) return;
						if (e.key === 'ArrowLeft') go(page - 1);
						else if (e.key === 'ArrowRight') go(page + 1);
						else return;
						e.preventDefault();
					});

					// Tabbing to a link on another page would scroll the clipped
					// pager instead; undo that and turn to the link's page.
					pager.addEventListener('scroll', () => { pager.scrollLeft = 0; });
					pager.addEventListener('focusin', (e) => {
						if (controls.hidden) return;
						const offset = e.target.getBoundingClientRect().left - pages.getBoundingClientRect().left;
						go(Math.floor(offset / stride()));
					});

					// Recount whenever the page window changes size: window resizes,
					// the breakpoint, late fonts or late styles. Deferred a frame so the
					// controls toggling inside layout() doesn't re-enter the observer.
					let frame = 0;
					const schedule = () => {
						cancelAnimationFrame(frame);
						frame = requestAnimationFrame(layout);
					};
					new ResizeObserver(schedule).observe(pager);
					desktop.addEventListener('change', schedule);
					addEventListener('resize', schedule);
					document.fonts?.ready.then(layout);
					layout();
				})();
			</script>
			{form === 'story' && (
				<script is:inline>
					// Mobile reading bar. The fill runs from 0% when the story text
					// reaches the top of the viewport to 100% when its last line comes
					// into view. The read time is built into the page and never counts
					// down; on the last screen it gives way to "Almost done". The bar
					// stays hidden without this script and above 800px. The back-to-top
					// link works on its own; this only holds it back until the reader is
					// past the first screen.
					(() => {
						const entry = document.currentScript.closest('.entry-story');
						const bar = entry.querySelector('.read-bar');
						const fill = bar.querySelector('.read-bar-fill');
						const label = bar.querySelector('.read-bar-text');
						const toTop = entry.querySelector('.to-top');
						const text = entry.querySelector('.pages');
						const readTime = label.textContent;
						const mobile = matchMedia('(max-width: 800px)');
						let frame = 0;

						function update() {
							frame = 0;
							toTop.hidden = scrollY <= innerHeight;

							const last = text.lastElementChild;
							const rects = last ? last.getClientRects() : [];
							if (!rects.length) return;
							const start = text.getBoundingClientRect().top;
							const end = rects[rects.length - 1].bottom - innerHeight;
							const span = Math.max(1, end - start);
							const progress = Math.min(1, Math.max(0, -start / span));
							fill.style.transform = `scaleX(${progress})`;

							const message = end <= 0 ? 'Almost done' : readTime;
							if (label.textContent !== message) label.textContent = message;
						}

						function schedule() {
							if (mobile.matches && !frame) frame = requestAnimationFrame(update);
						}

						function toggle() {
							bar.hidden = !mobile.matches;
							if (!mobile.matches) toTop.hidden = true;
							schedule();
						}

						addEventListener('scroll', schedule, { passive: true });
						addEventListener('resize', schedule);
						mobile.addEventListener('change', toggle);
						toggle();
					})();
				</script>
			)}
			</>
		) : (
			<>
				<h1>{title}</h1>
				<p class="entry-date">
					<strong>Last updated: </strong><time datetime={iso}>{pretty}</time>
				</p>
				<slot />
			</>
		)}
	</article>
</SiteLayout>

<style>
  .entry-project {
    max-width: 150ch;
    line-height: 1.5;
  }

  .entry-project h1 {
    font-family: 'Caveat', cursive;
    font-size: 44px;
    font-weight: 600;
    margin: 20px 0 0;
  }

  .entry-writing {
    line-height: 1.6;
  }

  .entry-writing .entry-date {
    color: #7a705c;
    margin: 0 0 16px;
  }

  .entry-story {
    text-align: justify;
  }

  .back-link {
    color: #0b44c4;
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  /* --- desktop pagination (the script adds .paginated) --- */

  .pager-controls[hidden] {
    display: none;
  }

  @media (min-width: 801px) {
    /* Fit the viewport below the nav: 180px is the nav, the book's top
       margin and the column's bottom padding. */
    .paginated :global(.book) {
      box-sizing: border-box;
      height: calc(100vh - 180px);
      min-height: 420px;
    }

    .paginated :global(.leaf) {
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    .paginated :global(.leaf-left) {
      align-items: flex-start;
    }

    .paginated :global(.leaf-right) {
      overflow: hidden;
    }

    /* The page window takes whatever the controls leave, and the columns
       are pinned to it so their height is always definite. */
    .paginated .pager {
      position: relative;
      flex: 1;
      min-height: 0;
      overflow: hidden;
    }

    .paginated .pages {
      position: absolute;
      inset: 0;
      column-count: 1;
      column-gap: 80px;
      column-fill: auto;
    }

    .paginated .pages :global(p) {
      break-inside: avoid;
    }

    /* Stories fill each page to the bottom, splitting paragraphs if needed. */
    .paginated.entry-story .pages :global(p) {
      break-inside: auto;
      orphans: 2;
      widows: 2;
    }

    .pager-controls {
      flex-shrink: 0;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 10px;
      padding-top: 12px;
      border-top: 1px dotted #b8ab8c;
      color: #7a705c;
    }

    .pager-controls button {
      padding: 0;
      border: none;
      background: none;
      font: inherit;
      color: #0b44c4;
      cursor: pointer;
    }

    .pager-controls button[aria-disabled='true'] {
      color: #b8ab8c;
      cursor: default;
    }
  }

  /* --- mobile story extras: reading bar, back to top --- */

  .read-bar {
    position: fixed;
    top: env(safe-area-inset-top);
    left: 0;
    z-index: 1000;
    width: 100%;
    height: 26px;
    box-sizing: border-box;
    overflow: hidden;
    border-bottom: 1px solid #7a705c;
    background: #f4eedf;
    color: #2a2620;
    font-size: 12px;
    line-height: 25px;
    text-align: center;
  }

  .read-bar-fill {
    position: absolute;
    inset: 0;
    background: #9cd2f2;
    transform: scaleX(0);
    transform-origin: left;
  }

  .read-bar-text {
    position: relative;
  }

  .to-top {
    position: fixed;
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom));
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: #0b44c4;
    color: #f4eedf;
    font-size: 20px;
    text-decoration: none;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25);
  }

  .read-bar[hidden],
  .to-top[hidden] {
    display: none;
  }

  @media (min-width: 801px) {
    .read-bar,
    .to-top {
      display: none;
    }
  }

  @media (max-width: 800px) and (prefers-reduced-motion: no-preference) {
    :global(html:has(.entry-story)) {
      scroll-behavior: smooth;
    }
  }

	@media (max-width: 800px) {
		.entry-poem {
		font-size: clamp(13px, 3.5vw, 16px);
		}
	}
</style>