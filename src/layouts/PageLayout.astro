---
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" />
  </head>
  <body>
    <div class="page">
      <div class="main">
        <Nav />

        <slot />
      </div>
    </div>
  </body>
</html>

<style>
  /* --- page shell --- */

  body {
    margin: 0;
  }

  .page {
    min-height: 100vh;
    background: #f4eedf;
    color: #2a2620;
    box-sizing: border-box;
  }

  /* --- content (Nav's negative margins rely on this padding) --- */

  .main {
    padding: 40px;
  }

  /* --- mobile --- */

  @media (max-width: 800px) {
    .main {
      padding: 20px;
    }
  }
</style>
