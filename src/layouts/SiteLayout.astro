---
import Nav from '../components/Nav.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Caveat:wght@400;600;700&family=Newsreader:opsz,wght@6..72,400;6..72,500&display=swap" />
  </head>
  <body>
    <div class="page">
      <aside class="who">
        <div class="portrait">
          <img src="/images/avatar.webp" alt="Portrait of Keith Rodrigues" />
        </div>
        <h1 class="name">Keith Rodrigues</h1>
        <p class="bio">
          Computer Science graduate who builds backend systems and writes
          poems and stories. This site is where both sides meet.
        </p>
        <ul class="facts">
          <li>
            <img src="/images/icons/Github.png" alt="" />
            <a href="https://github.com/Keith2205" target="_blank" rel="noopener noreferrer">GitHub</a>
          </li>
          <li>
            <img src="/images/icons/LinkedIn.png" alt="" />
            <a href="https://www.linkedin.com/in/keith-rodrigues-658b7530a" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          </li>
          <li>
            <img src="/images/icons/Gmail.png" alt="" />
            <a href="mailto:keith@keithrodrigues.com">Email</a>
          </li>
        </ul>
      </aside>

      <div class="main">
        <Nav />

        <slot />
      </div>
    </div>
  </body>
</html>

<style>
  /* --- page shell --- */

  body {
    margin: 0;
  }

  .page {
    display: flex;
    height: 100vh;
    min-height: 100vh;
    overflow: hidden;
    background: #f4eedf;
    color: #2a2620;
    padding: 0;
    box-sizing: border-box;
  }

  /* --- left sidebar --- */

  .who {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 300px;
    height: 100%;
    box-sizing: border-box;
    padding: 40px;
    border-right: 3px solid #0e0a01;
  }

  .portrait {
    width: 190px;
    aspect-ratio: 1;
  }

  .portrait img {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 3px solid #221605;
    object-fit: cover;
    object-position: 50% 18%;
    background: #ccf452;
  }

  .name {
    font-family: 'Caveat', cursive;
    font-size: 30px;
    margin: 18px 20px 0;
  }

  .bio {
    width: 100%;
    min-height: 120px;
    box-sizing: border-box;
    margin: 10px 0 0;
    padding: 10px 10px;
    border: 3px solid #2a2620;
    background: #fbf6e9;
    text-align: justify;
    font-size: 15px;
    line-height: 1.62;
    color: #4a4336;
  }

  .facts {
    display: flex;
    flex-direction: column;
    gap: 15px;
    margin: 30px 0 0;
    padding: 0;
    list-style: none;
    font-family: 'Newsreader', Georgia, serif;
    font-size: 16px;
    color: #4a4336;
  }

  .facts li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .facts img {
    width: 18px;
    height: 18px;
  }

  .facts a {
    color: #0b44c4;
    text-decoration: none;
  }

  .facts a:hover {
    text-decoration: underline;
  }

  /* --- right column (Nav's negative margins rely on this padding) --- */

  .main {
    flex: 1;
    padding: 40px;
    overflow-y: auto;
  }

  /* --- mobile --- */

  @media (max-width: 800px) {
    .page {
      flex-direction: column;
      height: auto;
      overflow: visible;
    }

    .who {
      width: 100%;
      height: auto;
      border-right: none;
      border-bottom: 3px solid #0e0a01;
    }

    .main {
      padding: 20px;
      overflow-y: visible;
    }
  }
</style>
