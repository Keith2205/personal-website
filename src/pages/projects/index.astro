---
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';

const projects = await getCollection('projects');
---

<SiteLayout title="Projects">
  <section class="board">
    {projects.map((entry) => (
      <a class="note" href={`/projects/${entry.id}`}>
        <span class="pin" aria-hidden="true"></span>
        <h2 class="note-title">{entry.data.title}</h2>
        <p class="note-summary">{entry.data.summary}</p>
        <ul class="note-tags">
          {entry.data.tech.map((t) => <li>{t}</li>)}
        </ul>
        <span class="note-go">Explore project →</span>
      </a>
    ))}
  </section>
</SiteLayout>

<style>
  .board {
    margin-top: 30px;
    min-height: 60vh;
    box-sizing: border-box;
    padding: 40px;
    background: #c9a06f;
    border: 12px solid #7a4f24;
    border-radius: 4px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 40px;
    align-items: start;
  }

  .note {
    position: relative;
    display: block;
    max-width: 300px;
    padding: 30px 22px 20px;
    background: #fbe38e;
    color: #3a2f10;
    text-decoration: none;
    transform: rotate(-3deg);
    box-shadow: 3px 4px 8px rgba(0, 0, 0, 0.25);
  }

  .note-title {
    font-family: 'Caveat', cursive;
    font-size: 30px;
    line-height: 1.1;
    margin: 0 0 10px;
  }

  .note-summary {
    margin: 0 0 14px;
    line-height: 1.5;
  }

  .note-tags {
    list-style: none;
    padding: 0;
    margin: 0 0 14px;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .note-tags li {
    font-size: 13px;
    padding: 2px 8px;
    border: 1px solid #8a7a3a;
    border-radius: 999px;
  }

  .pin {
    position: absolute;
    top: 10px;
    left: 50%;
    width: 14px;
    height: 14px;
    margin-left: -7px;
    border-radius: 50%;
    background: #c0392b;
    box-shadow: 1px 2px 3px rgba(0, 0, 0, 0.35);
  }

  .note-go {
    color: #0b44c4;
  }

  .note:hover .note-go {
    text-decoration: underline;
  }

  @media (max-width: 800px) {
    .board {
      padding: 25px;
	  min-height: 0;
    }
  }
</style>