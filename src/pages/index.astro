---
import BaseLayout from '../layouts/BaseLayout.astro';

// Two columns divided by a rule: an identity card on the left, and on the
// right the nav above a layered workspace scene. Everything in the scene is
// placed in percentages of the desk illustration, so the whole thing scales
// as one picture instead of drifting apart at odd widths.
//
// The homepage draws its own nav, so the shared one is switched off.
const FONTS =
	'https://fonts.googleapis.com/css2?family=Caveat:wght@400;600;700&family=JetBrains+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&display=swap';

// The laptop screen, measured off workspace.webp as a share of the image box.
// The illustration draws it in perspective, so it is a quadrilateral rather
// than a rectangle and the overlay is clipped to these four corners. The
// measured corners are pushed out a shade so the panel laps onto the bezel
// rather than leaving a sliver of the mottled screen showing at the edges.
const SCREEN_QUAD = '36.1% 27.9%, 66.6% 29.4%, 64.3% 60.6%, 32.8% 54.9%';

const CODE = [
	{ n: 1, indent: 0, parts: [['kw', 'class '], ['cls', 'Keith'], ['pun', ':']] },
	{ n: 2, indent: 1, parts: [['kw', 'def '], ['fn', 'create'], ['pun', '('], ['self', 'self'], ['pun', '):']] },
	{ n: 3, indent: 2, parts: [['self', 'self'], ['pun', '.'], ['fn', 'build'], ['pun', '()']] },
	{ n: 4, indent: 2, parts: [['self', 'self'], ['pun', '.'], ['fn', 'write'], ['pun', '()']] }
];
---

<BaseLayout title="Keith Rodrigues" nav={false}>
	<Fragment slot="head">
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href={FONTS} />
	</Fragment>

	<div class="page">
		<div class="shell">
			<!-- ---------------------------------------------------------- -->
			<aside class="who">
				<div class="portrait">
					<img src="/images/avatar.webp" width="440" height="469" alt="Portrait of Keith Rodrigues" />
					<svg class="portrait-ring" viewBox="0 0 100 100" aria-hidden="true">
						<path
							d="M50 2.6 C 71.5 2.2, 97.2 23.8, 97.4 49.2 C 97.6 73.6, 74.2 97.6, 49.4 97.4 C 25.8 97.2, 2.4 74.4, 2.6 49.6 C 2.8 24.6, 28.2 3, 50 2.6 Z"
							fill="none"
							stroke="#2A2620"
							stroke-width="2.1"
							stroke-linecap="round"></path>
						<path
							class="ghost"
							d="M50.6 4.4 C 70.4 4.6, 95.2 25.4, 95.6 49.8 C 96 73, 73.4 95.6, 49.8 95.4 C 27 95.2, 4.4 73.2, 4.6 49.4 C 4.8 25.8, 29.4 4.2, 50.6 4.4 Z"
							fill="none"
							stroke="#2A2620"
							stroke-width="1.1"
							stroke-linecap="round"></path>
					</svg>
				</div>

				<div class="who-name">
					<h1 class="name">Keith Rodrigues</h1>
					<svg class="underline" viewBox="0 0 300 18" preserveAspectRatio="none" aria-hidden="true">
						<path
							d="M4 11.5 C 46 5.4, 104 6.2, 150 8.1 C 199 10.1, 252 7.4, 296 5.2 C 252 12.6, 198 15.4, 148 13.6 C 100 11.9, 48 13.4, 4 11.5 Z"
							fill="#0B44C4"></path>
					</svg>
				</div>

				<p class="bio">
					Computer Science graduate who builds backend systems and writes poems and
					stories. This site is where both sides meet.
				</p>

				<div class="who-facts">
					<hr class="rule" />

					<ul class="facts">
						<li>
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d="M2.4 8.6 L12 4.1 L21.6 8.6 L12 13.1 Z" />
								<path d="M6.2 10.4 V15.6 C8 17.3, 16 17.3, 17.8 15.6 V10.4" />
								<path d="M20.6 9.1 V14.2" />
							</svg>
							<span>Building with Java</span>
						</li>
						<li>
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<rect x="4.2" y="4.8" width="15.6" height="10.6" rx="1.3" />
								<path d="M1.9 18.4 H22.1" />
							</svg>
							<span>Writing stories and poems</span>
						</li>
						<li>
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<circle cx="12" cy="12" r="8.9" />
								<path d="M12 7.5 L15.7 10.2 L14.3 14.5 H9.7 L8.3 10.2 Z" />
								<path d="M12 7.5 V3.2 M15.7 10.2 L19.8 8.9 M14.3 14.5 L16.9 18.1 M9.7 14.5 L7.1 18.1 M8.3 10.2 L4.2 8.9" />
							</svg>
							<span>Football was plan A</span>
						</li>
					</ul>
				</div>
			</aside>

			<!-- ---------------------------------------------------------- -->
			<div class="main">
				<nav class="nav">
					<a href="/projects">Projects</a>
					<a href="/writing">Writings</a>
					<a href="/about">About</a>
					<a class="logo" href="/" aria-label="Keith Rodrigues — home">
						<img src="/images/logo.webp" width="200" height="200" alt="" />
					</a>
				</nav>
				<hr class="rule nav-rule" />

				<div class="stage">
					<div class="scene">
						<div class="desk">
							<img
								class="brush"
								src="/images/blue-brush-backdrop.webp"
								width="1200"
								height="800"
								alt=""
								aria-hidden="true"
							/>
							<img
								class="desk-art"
								src="/images/workspace.webp"
								width="1400"
								height="933"
								alt="An open laptop on a desk, with a stack of books, a potted plant, an open notebook and pen, a mug of coffee and a football behind it."
							/>
							<!-- Covers the illustration's mottled screen so the code sits
							     on a flat panel. Decorative: the page says elsewhere,
							     in real text, everything this repeats. -->
							<div class="screen" style={`clip-path: polygon(${SCREEN_QUAD})`} aria-hidden="true">
								<div class="code">
									{CODE.map((line) => (
										<div class="code-line">
											<span class="ln">{line.n}</span>
											<span class="src" style={`padding-left: ${line.indent * 2}ch`}>
												{line.parts.map(([kind, text]) => <span class={kind}>{text}</span>)}
											</span>
										</div>
									))}
								</div>
							</div>
						</div>

						<div class="card card-project">
							<img
								class="paper"
								src="/images/blank-paper-card-tape.webp"
								width="800"
								height="600"
								alt=""
								aria-hidden="true"
							/>
							<div class="card-text">
								<span class="kicker">Latest project</span>
								<span class="headline">Credit Card Fraud Detection</span>
								<a class="go" href="/projects/credit-card-fraud-detection">Explore project →</a>
							</div>
						</div>

						<div class="card card-writing">
							<img
								class="paper"
								src="/images/blank-paper-card-clip.webp"
								width="800"
								height="600"
								alt=""
								aria-hidden="true"
							/>
							<div class="card-text">
								<span class="kicker">Featured writing</span>
								<span class="headline">The Ore</span>
								<a class="go" href="/writing/poems/the-ore">Read the poem →</a>
							</div>
						</div>

						<img class="mark mark-arrow" src="/images/marks/arrow-right.webp" alt="" aria-hidden="true" />
						<img class="mark mark-star" src="/images/marks/star.webp" alt="" aria-hidden="true" />
						<img class="mark mark-ticks" src="/images/marks/ticks-left.webp" alt="" aria-hidden="true" />
					</div>
				</div>
			</div>
		</div>
	</div>
</BaseLayout>

<style>
	:global(body) {
		margin: 0;
		background: #f4eedf;
	}

	.page {
		--ink: #2a2620;
		--ink-soft: #4a4336;
		--paper: #f4eedf;
		--blue: #0b44c4;
		--navy: #2f3a5c;
		--line: #cabda0;

		min-height: 100vh;
		background: var(--paper);
		color: var(--ink);
		font-family: 'Newsreader', Georgia, serif;
	}

	.shell {
		box-sizing: border-box;
		max-width: 1240px;
		margin: 0 auto;
		padding: 32px 16px 72px;
	}

	.rule {
		height: 0;
		margin: 0;
		border: 0;
		border-top: 1px solid var(--line);
	}

	/* --- left column ----------------------------------------------------- */

	.who {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
	}

	/* Grouping wrappers: they keep the name with its brushstroke, and the
	   rule with the three lines, so the desktop column can space the four
	   blocks apart without prising those pairs open. Full width so the
	   brushstroke and the rule still measure against the column. */
	.who-name,
	.who-facts {
		align-self: stretch;
	}

	.portrait {
		position: relative;
		width: 190px;
		max-width: 60%;
		aspect-ratio: 1;
	}

	.portrait img {
		width: 100%;
		height: 100%;
		border-radius: 50%;
		object-fit: cover;
		/* The artwork sits high in its frame; nudging the crop down keeps the
		   face centred in the circle instead of cropping the chin. */
		object-position: 50% 18%;
		background: #e9e0c9;
	}

	/* Laid over the photo rather than drawn as a border, so the doubled ink
	   line reads as one hand-drawn ring. */
	.portrait-ring {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		overflow: visible;
	}

	.ghost {
		opacity: 0.45;
	}

	.name {
		margin: 18px 0 0;
		font-family: 'Caveat', cursive;
		font-weight: 700;
		font-size: clamp(38px, 4.4vw, 52px);
		line-height: 1.05;
		letter-spacing: 0.01em;
	}

	.underline {
		width: 82%;
		min-width: 190px;
		height: 13px;
		margin-top: 8px;
	}

	.bio {
		box-sizing: border-box;
		margin: 22px 0 0;
		padding: 18px 20px;
		border: 1px solid var(--ink);
		background: #fbf6e9;
		font-size: 16px;
		line-height: 1.62;
		color: var(--ink-soft);
	}

	.who .rule {
		align-self: stretch;
		margin: 26px 0;
	}

	.facts {
		display: flex;
		flex-direction: column;
		gap: 15px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.facts li {
		display: flex;
		align-items: center;
		gap: 12px;
		font-size: 16px;
		color: var(--ink-soft);
	}

	.facts svg {
		flex: none;
		width: 21px;
		height: 21px;
		fill: none;
		stroke: var(--blue);
		stroke-width: 1.5;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	/* --- nav ------------------------------------------------------------- */

	/* Stacked, the nav follows the three lines of the left column and needs
	   its own air; side by side it sits at the top of its column instead. */
	.main {
		margin-top: 34px;
	}

	.nav {
		display: flex;
		align-items: center;
		gap: clamp(16px, 3vw, 34px);
		font-family: 'Caveat', cursive;
		font-size: clamp(24px, 2.6vw, 30px);
	}

	.nav a {
		color: var(--navy);
		text-decoration: none;
	}

	.nav a:hover {
		color: var(--blue);
		text-decoration: underline;
		text-underline-offset: 4px;
	}

	.logo {
		margin-left: auto;
		line-height: 0;
	}

	.logo img {
		width: 46px;
		height: 46px;
	}

	.nav-rule {
		margin-top: 12px;
	}

	/* --- the workspace scene --------------------------------------------- */
	/* Mobile first: the desk, then the two cards stacked beneath it. */

	.scene {
		display: flex;
		flex-direction: column;
		gap: 22px;
		margin-top: 26px;
	}

	.desk {
		position: relative;
		/* The code panel is sized in cqw so it tracks the illustration rather
		   than the viewport — the laptop screen is a fixed share of this box. */
		container-type: inline-size;
	}

	.desk-art {
		position: relative;
		z-index: 1;
		display: block;
		width: 100%;
		height: auto;
	}

	/* Behind and above the laptop: the sweep of the stroke crowns the screen.
	   Same 3:2 aspect as the desk art, so one percentage sets both axes. The
	   source is a closed loop — clipping to the upper sweep drops the return
	   stroke, which otherwise trails across empty paper beside the books. */
	.brush {
		position: absolute;
		z-index: 0;
		top: -12%;
		left: 2%;
		width: 84%;
		height: auto;
		clip-path: inset(0 0 46% 0);
		opacity: 0.9;
	}

	.screen {
		position: absolute;
		z-index: 2;
		inset: 0;
		background: #171a21;
	}

	.code {
		position: absolute;
		/* The largest rectangle that fits inside the screen quad, less a
		   margin so no glyph runs into a slanted edge. */
		top: 33%;
		left: 38%;
		font-family: 'JetBrains Mono', ui-monospace, 'SFMono-Regular', Menlo, monospace;
		/* The floor keeps the code legible as code on a phone, where 1.8cqw
		   of a 358px illustration would render at about six pixels. */
		font-size: max(7px, 1.8cqw);
		line-height: 1.72;
		white-space: nowrap;
		/* The illustration draws the screen tilted a little; matching it keeps
		   the code sitting on the glass rather than floating over it. */
		transform: rotate(1.8deg);
		transform-origin: top left;
	}

	.code-line {
		display: flex;
	}

	.ln {
		flex: none;
		width: 2.2ch;
		margin-right: 1.1ch;
		text-align: right;
		color: #7e8794;
	}

	.kw {
		color: #ff7b72;
	}

	.cls {
		color: #ffa657;
	}

	.fn {
		color: #d2a8ff;
	}

	.self {
		color: #79c0ff;
	}

	.pun {
		color: #c9d1d9;
	}

	/* --- the two paper cards --------------------------------------------- */

	.card {
		position: relative;
		/* Card text scales with the card, which is a different width on the
		   phone (full bleed) than on the desktop (a corner of the scene). */
		container-type: inline-size;
	}

	.paper {
		display: block;
		width: 100%;
		height: auto;
	}

	/* Inset to the flat middle of the torn sheet, clear of the tape and clip. */
	.card-text {
		position: absolute;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 1.6cqw;
		inset: 27% 11% 15% 12%;
		justify-content: center;
	}

	.kicker {
		font-family: 'Caveat', cursive;
		font-size: 6.8cqw;
		line-height: 1;
		color: #8f5214;
	}

	.headline {
		font-size: 7.8cqw;
		font-weight: 500;
		line-height: 1.14;
		color: var(--ink);
	}

	.go {
		font-size: 4.8cqw;
		color: var(--blue);
		text-decoration: none;
	}

	/* Makes the whole card clickable while leaving one properly labelled
	   link for the keyboard and the screen reader. */
	.go::after {
		content: '';
		position: absolute;
		inset: -6% -4%;
	}

	.card:hover .go,
	.go:focus-visible {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* The clipped sheet is torn a little lower and carries its clip in the
	   middle of the top edge, so its text starts further down than the taped
	   one's. */
	.card-writing .card-text {
		inset: 30% 11% 14% 12%;
	}

	/* Decorative accents, desktop only. */
	.mark {
		display: none;
	}

	/* --- desktop --------------------------------------------------------- */

	@media (min-width: 900px) {
		/* One screenful: the shell takes whatever height the viewport has and
		   the two columns divide it, rather than both stacking to their
		   natural height and leaving the rest of the screen blank. */
		.page {
			--shell-pad-y: 36px;
			/* Past this much column, spreading the four blocks further apart
			   stops reading as composition and starts reading as gaps. */
			--who-spread: 780px;

			display: flex;
			flex-direction: column;
		}

		.shell {
			display: grid;
			grid-template-columns: 28% minmax(0, 1fr);
			/* The single row fills the shell — `auto` would size it to the
			   content and put the slack back at the bottom. */
			grid-template-rows: minmax(0, 1fr);
			flex: 1;
			gap: 0 clamp(32px, 4vw, 54px);
			max-width: 1400px;
			padding: var(--shell-pad-y) 32px;
		}

		.main {
			display: flex;
			flex-direction: column;
			min-height: 0;
			margin-top: 0;
		}

		/* Stretched by the grid's default alignment, so the divider runs the
		   full height of the row rather than stopping under the last line. */
		.who {
			justify-content: space-between;
			gap: 20px;
			/* Absorbs whatever height is left over beyond --who-spread, so a
			   tall screen pads the column rather than prising the four blocks
			   apart. The padding sits inside the border, so the divider still
			   runs the full height. */
			padding-block: max(0px, calc((100vh - 2 * var(--shell-pad-y) - var(--who-spread)) / 2));
			padding-right: clamp(32px, 4vw, 54px);
			border-right: 1px solid var(--line);
		}

		/* space-between owns the spacing here; the authored margins that set
		   the rhythm in the stacked layout would double up on it. */
		.who .name,
		.who .bio {
			margin-top: 0;
		}

		.who .rule {
			margin: 0 0 22px;
		}

		.portrait {
			width: 190px;
			max-width: 100%;
		}

		/* Holds the scene in the space left under the nav and centres it. */
		.stage {
			display: flex;
			flex: 1;
			align-items: center;
			justify-content: center;
			min-height: 0;
			padding-top: 16px;
		}

		.scene {
			position: relative;
			display: block;
			/* Everything in the scene is a share of this width, so capping the
			   width against the height left on screen is what keeps the page
			   to one screenful. 1.271 is the scene's own width:height — the
			   desk art's 3:2 plus the 12% of width the padding below adds.
			   176px is the chrome above and below it: the shell's padding,
			   the nav and its rule, this stage's padding, and a little slack.
			   (An aspect-ratio here does not work: when max-width binds,
			   height:100% wins and the box stretches out of proportion.) */
			width: min(100%, calc((100vh - 176px) * 1.271));
			margin-top: 0;
			container-type: inline-size;
			/* Room for the cards, which hang off the illustration's corners. */
			padding: 3% 0 9%;
		}

		.card {
			position: absolute;
			z-index: 4;
			width: 38%;
		}

		.card-project {
			top: 0;
			left: -5%;
			transform: rotate(-2.4deg);
		}

		.card-writing {
			right: -4%;
			bottom: 0;
			transform: rotate(1.8deg);
		}

		.mark {
			display: block;
			position: absolute;
			z-index: 3;
			height: auto;
		}

		/* Sweeps down off the desk toward the writing card. */
		.mark-arrow {
			right: 38%;
			bottom: 14%;
			width: 9.5%;
			transform: rotate(14deg);
		}

		.mark-star {
			top: 4%;
			right: 16%;
			width: 5.4%;
		}

		.mark-ticks {
			bottom: 10%;
			left: 1%;
			width: 7%;
			transform: rotate(-16deg);
		}
	}

	/* --- narrow phones ---------------------------------------------------- */

	@media (max-width: 420px) {
		.shell {
			padding: 26px 16px 60px;
		}

		.nav {
			gap: 14px;
			font-size: 23px;
		}

		.logo img {
			width: 38px;
			height: 38px;
		}
	}
</style>
