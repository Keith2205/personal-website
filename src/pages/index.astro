---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout title="Keith Rodrigues">
    <div class="scene">
        <img class="desk-art" src="/images/workspace.png" alt="An open laptop on a desk with books, a plant, a notebook and pen, a mug, and a football." />
    
                    <div class="screen" aria-hidden="true">
<pre class="code">class Keith:
    def create(self):
        self.build()
        self.write()</pre>
        </div>
        <div class="card card-project">
            <img class="paper" src="/images/blank-paper-card-tape.webp" alt="" aria-hidden="true" />
            <div class="card-text">
                <span class="kicker">Latest project</span>
                <span class="headline">Credit Card Fraud Detection</span>
                <a class="go" href="/projects/credit-card-fraud-detection">Explore project →</a>
            </div>
        </div>
        <div class="clip clip-writing">
            <img class="paper" src="/images/blank-paper-card-clip.webp" alt="" aria-hidden="true" />
            <div class="clip-text">
                <span class="kicker">Featured writing</span>
                <span class="headline">The Ore</span>
                <a class="go" href="/writing/poems/the-ore">Read the poem →</a>
            </div>
        </div>         
    </div>
</SiteLayout>

<style>
  /* --- scene --- */

  .scene {
    position: relative;
    margin-top: 30px;
    width: min(100%, calc(100vh + 100px));
    margin-left: auto;
    margin-right: auto;
  }

  .desk-art {
    display: block;
    width: 100%;
    height: auto;
  }

  .screen {
    position: absolute;
    z-index: 2;
    top: 28%;
    left: 43%;
    width: 20%;
    height: 20%;
    transform: rotate(2deg);
  }

  .code {
    margin: 10px;
    padding: 5% 5%;
    font-family: ui-monospace, monospace;
    font-size: 15px;
    line-height: 2.0;
    color: #f5f9fc;
    text-align: left;
  }

  .card,
  .clip {
    position: absolute;
    z-index: 4;
    width: 40%;
  }

  .card-project {
    top: 60px;
    left: -20%;
    transform: rotate(-10deg);
  }

  .card-text {
    position: absolute;
    inset: 0% 0% 0% 20%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
    transform: rotate(5deg);
  }

  .clip-writing {
    top: -100px;
    right: -4%;
    transform: rotate(2deg);
  }

  .clip-text{
    position: absolute;
    inset: 15% 10% 5% 25%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
    transform: rotate(6deg);
  }

  .paper {
    display: block;
    width: 100%;
    height: auto;
  }

  .go {
    color: #0b44c4;
    text-decoration: none;
  }
  
  .go:hover {
    text-decoration: underline;
  }

  /* --- mobile --- */

  @media (max-width: 800px) {
    .card,
    .clip {
      position: relative;
      inset: auto;
      width: 80%;
      margin: -40px auto 0;
    }
    
    .screen {
      display: none;
    }
    
    .go {
      color: #0b44c4;
      text-decoration: underline;
    }
  }  
</style>