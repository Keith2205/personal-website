---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const music = await getCollection('music');
---

<BaseLayout title="Music">
	<h1>Music</h1>
	<ul>
		{music.map((entry) => (
			<li><a href={`/music/${entry.id}`}>{entry.data.title}</a></li>
		))}
	</ul>
</BaseLayout>
